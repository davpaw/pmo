{
  "name": "pmo-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Host repository for the PMO tool, using PMO against itself.",
  "scripts": {
    "pmo": "node pmo/scripts/pmo.mjs",
    "pmo:build": "node pmo/scripts/pmo.mjs build --git",
    "pmo:validate": "node pmo/scripts/pmo.mjs validate --fresh",
    "pmo:dev": "node pmo/scripts/pmo.mjs build --git && node pmo/scripts/run-vite.mjs dev",
    "pmo:preview": "node pmo/scripts/run-vite.mjs preview",
    "test": "node --test pmo/src/*.test.js pmo/src/agent/*.test.js pmo/src/node/*.test.js pmo/src/ui/*.test.js",
    "build": "node pmo/scripts/pmo.mjs build --git && vite build pmo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/davpaw/pmo.git"
  },
  "bin": {
    "pmo": "pmo/scripts/pmo.mjs"
  },
  "files": [
    "pmo/src/",
    "pmo/scripts/",
    "pmo/templates/",
    "pmo/package.json",
    "pmo/AGENTS.md",
    "pmo/CONTRIBUTING.md",
    "pmo/index.html",
    "pmo/vite.config.js",
    "README.md",
    "pmo/docs/"
  ],
  "dependencies": {
    "vite": "^8.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reactflow": "^11.11.4",
    "typescript": "^6.0.2"
  }
}
